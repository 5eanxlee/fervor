# Copy outside the repository and keep mode 600. Passwords must be URL-safe.
FERVOR_DB_PASSWORD=
FERVOR_JWT_SECRET=
FERVOR_FRONTEND_URL=http://localhost:8080
# Optional: restrict the private lab to one authenticated Fervor user UUID.
FERVOR_REPLAY_USER_ID=

FERVOR_REPLAY_DIR=/absolute/path/to/replay-corpus
FERVOR_REPLAY_RUNTIME=/absolute/path/to/replay-runtime
FERVOR_REPLAY_AUTH_FILE=/absolute/path/to/replay-api-auth.json
FERVOR_REPLAY_TOKEN_FILE=/absolute/path/to/replay-api-token
FERVOR_SECRET_GID=
FERVOR_REPLAY_RUN=quant-cloud

FERVOR_REPLAY_MINT=
FERVOR_REPLAY_SYMBOL=QUANT
FERVOR_REPLAY_NAME=Gen Z Quant
FERVOR_REPLAY_LOGO=https://cdn.dexscreener.com/cms/images/11a850389c2b2539d446d54d9a88cec3fcb13486aafdc8c5c04756aa48c5abc0?width=800&height=800&quality=95&format=auto
FERVOR_REPLAY_SUPPLY=1000000000
FERVOR_EDGE_PORT=8080
