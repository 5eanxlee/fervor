{
    "name": "@fervor/backend",
    "version": "1.0.0",
    "description": "Backend API and workers for Fervor",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "dev:matcher": "ts-node-dev --respawn --transpile-only src/alert-matcher-worker.ts",
        "dev:matcher:rust": "cargo run --manifest-path ../fervor-feed-rs/Cargo.toml --bin fervor-alert-matcher",
        "dev:indexer:rust": "cargo run --manifest-path ../fervor-feed-rs/Cargo.toml --bin fervor-market-indexer",
        "dev:candidates": "ts-node-dev --respawn --transpile-only src/alert-candidate-worker.ts",
        "dev:notifications": "ts-node-dev --respawn --transpile-only src/notification-worker.ts",
        "dev:outbox": "ts-node-dev --respawn --transpile-only src/outbox-worker.ts",
        "dev:wallets": "ts-node-dev --respawn --transpile-only src/wallet-indexer.ts",
        "dev:candles": "ts-node-dev --respawn --transpile-only src/candle-worker.ts",
        "dev:trades": "ts-node-dev --respawn --transpile-only src/market-trade-worker.ts",
        "dev:metrics": "ts-node-dev --respawn --transpile-only src/market-metric-worker.ts",
        "dev:integrations": "ts-node-dev --respawn --transpile-only src/integration-worker.ts",
        "dev:executions": "ts-node-dev --respawn --transpile-only src/execution-reconciler.ts",
        "dev:egress-recovery": "ts-node-dev --respawn --transpile-only src/egress-recovery.ts",
        "dev:blob-retention": "ts-node-dev --respawn --transpile-only src/blob-retention.ts",
        "project:replay": "node dist/metric-replay.js",
        "replay:lab": "node dist/replay-lab.js",
        "build": "tsc",
        "test": "vitest run",
        "start": "node dist/index.js",
        "start:matcher": "node dist/alert-matcher-worker.js",
        "start:candidates": "node dist/alert-candidate-worker.js",
        "start:notifications": "node dist/notification-worker.js",
        "start:outbox": "node dist/outbox-worker.js",
        "start:wallets": "node dist/wallet-indexer.js",
        "start:candles": "node dist/candle-worker.js",
        "start:trades": "node dist/market-trade-worker.js",
        "start:metrics": "node dist/market-metric-worker.js",
        "start:integrations": "node dist/integration-worker.js",
        "start:executions": "node dist/execution-reconciler.js",
        "start:egress-recovery": "node dist/egress-recovery.js",
        "start:blob-retention": "node dist/blob-retention.js",
        "start:production": "pm2 start ecosystem.config.js --env production",
        "stop:production": "pm2 stop ecosystem.config.js",
        "restart:production": "pm2 restart ecosystem.config.js",
        "logs": "pm2 logs",
        "monitor": "pm2 monit",
        "migrate": "npm --prefix .. run migrate"
    },
    "dependencies": {
        "@aws-sdk/client-kms": "^3.1103.0",
        "axios": "^1.6.2",
        "bs58": "^6.0.0",
        "cors": "^2.8.5",
        "discord.js": "^14.21.0",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "helmet": "^7.1.0",
        "ioredis": "^5.3.2",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "pg": "^8.11.3",
        "tweetnacl": "^1.0.3",
        "ws": "^8.21.3",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.10.5",
        "@types/pg": "^8.10.9",
        "@types/supertest": "^7.2.0",
        "@types/ws": "^8.18.1",
        "supertest": "^7.2.2",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3",
        "vitest": "^4.1.5"
    }
}
