# Database
CORE_DATABASE_URL=postgresql://fervor@localhost:55432/fervor
MARKET_DATABASE_URL=postgresql://fervor@localhost:55433/fervor
# Legacy single-database fallback is available only when DB_COLOCATED=true.
DATABASE_URL=
DB_COLOCATED=false
# Flyway uses JDBC URLs from its isolated, digest-pinned container. These point
# at the two local PostgreSQL planes provisioned by docker-compose.yml.
CORE_FLYWAY_URL=jdbc:postgresql://host.docker.internal:55432/fervor
CORE_DB_USER=fervor
CORE_DB_PASSWORD=
MARKET_FLYWAY_URL=jdbc:postgresql://host.docker.internal:55433/fervor
MARKET_DB_USER=fervor
MARKET_DB_PASSWORD=
# Production Compose builds its JDBC URLs from delimiter-safe fields. Hosts are
# DNS names or IPv4 literals; IPv6 URL literals are not accepted by this runner.
CORE_DB_HOST=
CORE_DB_PORT=5432
CORE_DB_NAME=
MARKET_DB_HOST=
MARKET_DB_PORT=5432
MARKET_DB_NAME=
MIGRATION_TIMEOUT_MS=3600000
MIGRATION_TIMEOUT_SEC=3600
MIGRATION_ENV=development
# Production deploys only after the migration preflight proves distinct cluster
# system identifiers; local development uses distinct containers too.
MIGRATION_COLOCATED=false
# Production Compose reads these standalone file-backed secrets. Missing or
# empty files fail before Flyway starts; never place their contents in this file.
CORE_DB_PASSWORD_FILE=
CORE_DB_CA_FILE=
MARKET_DB_PASSWORD_FILE=
MARKET_DB_CA_FILE=
# Controlled adoption requires an approved catalog digest and change record.
CORE_LEGACY_CATALOG_SHA256=
MARKET_LEGACY_CATALOG_SHA256=
MIGRATION_CHANGE_ID=
MIGRATION_OFFLINE=false
REDIS_URL=redis://localhost:6379
CORE_DB_POOL_MAX=10
CORE_DB_POOL_MIN=0
CORE_DB_TIMEOUT_MS=15000
MARKET_DB_POOL_MAX=10
MARKET_DB_POOL_MIN=0
EGRESS_DB_POOL_MAX=4
EGRESS_DB_POOL_MIN=0
EGRESS_ACQUIRE_MS=1000
EGRESS_RECOVERY_MS=1000
EGRESS_RECOVERY_BATCH=256
EGRESS_HEALTH_PORT=9465
EGRESS_MAX_ERRORS=5
MARKET_DB_TIMEOUT_MS=15000
# Deprecated common fallbacks; prefer the plane-specific budgets above.
DB_POOL_MAX=
DB_POOL_MIN=
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
DB_SSL_MODE=disable
DB_SSL_CA=

# Required server secret
# Use a unique random value with at least 32 characters. Never commit the real value.
JWT_SECRET=replace_with_a_random_64_character_secret
AUTH_USER_CACHE_TTL_SEC=60

# Application
NODE_ENV=development
API_PORT=3010
FRONTEND_URL=http://localhost:3002
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Set to the exact number of trusted reverse-proxy hops in production.
TRUST_PROXY_HOPS=0
DB_LOG_QUERIES=false
METRICS_BEARER_TOKEN=

# Optional single-owner historical replay host bridge. Configure all four fields.
# The API reads the replay bearer token from disk and never exposes it to browser code.
REPLAY_API_SOCKET=
REPLAY_API_AUTH_FILE=
REPLAY_API_TOKEN_FILE=
REPLAY_API_USER_ID=
REPLAY_API_TIMEOUT_MS=3000
REPLAY_API_MAX_BYTES=2097152
# Authenticated binary WebSocket gateway at /api/realtime/v1.
RT_AUTH_MS=5000
RT_HEARTBEAT_MS=15000
RT_POLL_MS=20
RT_QUEUE_BYTES=1048576
RT_QUEUE_FRAMES=512
RT_MAX_SUBS=32
RT_RESUME_EVENTS=20000
RT_MAX_PAYLOAD_BYTES=16384

# Market-data ingestion
MARKET_DATA_REQUIRED=false
LATENCY_SAMPLE_RATE=1
MARKET_DATA_COMMITMENT=confirmed
# Minimum market cap for an on-curve token to enter Final Stretch.
# Tune this to the active launchpad migration policy.
DISCOVERY_FINAL_STRETCH_USD=45000
HELIUS_API_KEY=
HELIUS_API_URL=https://mainnet.helius-rpc.com
HELIUS_LASERSTREAM_ENDPOINT=https://laserstream-mainnet-ewr.helius-rpc.com
# Optional comma-separated Yellowstone endpoints. The Rust indexer rotates endpoints on failure.
YELLOWSTONE_ENDPOINTS=
# Authentication for explicit Yellowstone endpoints. Helius fallback uses HELIUS_API_KEY.
YELLOWSTONE_X_TOKEN=
# Required for explicit endpoints so provider provenance is never guessed.
MARKET_SOURCE=
SOLANA_NETWORK=mainnet-beta
INDEXER_RECONNECT_MAX_MS=30000

# Financial mutation remains disabled until it is routed through the isolated gateway.
TRADING_MODE=disabled
ORDER_MODE=disabled
ORDER_OP_LEASE_MS=30000
ORDER_SYNC_MAX_PAGES=20
# Signed order transactions use per-message data keys. Production accepts only
# AWS KMS envelope wrapping; credentials and region use the standard AWS chain.
TX_KEY_PROVIDER=disabled
TX_KMS_KEY_ID=
# Comma-separated canonical key ARNs or aliases retained only for decrypting older blobs.
TX_KMS_KEY_ALLOWLIST=
TX_KMS_TIMEOUT_MS=2000
TX_BLOB_TTL_MS=900000
ALLOW_LIVE_SUBMISSION=false
JUPITER_API_KEY=
JUPITER_API_URL=https://api.jup.ag
# Set these to the organisation's purchased Jupiter plan. Defaults match the free plan.
JUPITER_RATE_PER_MIN=60
JUPITER_EXEC_RATE_PER_SEC=50
JUPITER_RETRY_MAX_MS=300000
REF_PRICE_TTL_MS=5000
REF_PRICE_MAX_STALE_MS=60000
LIQUIDITY_TTL_MS=250
SOLANA_RPC_URL=
QUOTE_TTL_MS=15000
EXECUTION_TIMEOUT_MS=8000
EXECUTION_OP_LEASE_MS=30000
EXECUTION_RECONCILE_MS=2000
EXECUTION_RECONCILE_BATCH=256
EXECUTION_RECONCILE_LEASE_MS=25000
EXECUTION_SHARD_ID=0
EXECUTION_SHARD_COUNT=1
EXECUTION_MAX_STUCK_MS=300000
ORDER_MAX_STUCK_MS=300000
MARKET_MAX_STALE_MS=120000
OBS_COLLECT_MS=15000
MAX_SLIPPAGE_BPS=5000
MAX_PRIORITY_FEE_LAMPORTS=10000000
MAX_JITO_TIP_LAMPORTS=10000000
MAX_TRANSACTION_BYTES=3000

# Wallet history ingestion remains disabled until a live provider is configured.
WALLET_TRACKING_MODE=disabled
WALLET_POLL_INTERVAL_MS=15000
WALLET_TIMEOUT_MS=8000
WALLET_BACKFILL_LIMIT=100
WALLET_LEASE_MS=60000
WALLET_CONCURRENCY=16
WALLET_BACKOFF_MAX_MS=300000
WALLET_SHARD_ID=0
WALLET_SHARD_COUNT=1

# Optional notifications
ENABLE_NOTIFICATION_RETRY_WORKER=true
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_RETRY_BASE_MS=30000
NOTIFICATION_RETRY_MAX_MS=3600000
NOTIFICATION_MAX_PROVIDER_CONCURRENCY=50
NOTIFICATION_SEND_LEASE_MS=60000
NOTIFICATION_RATE_WINDOW_MS=1000
TELEGRAM_RATE_PER_SEC=25
TELEGRAM_CHAT_RATE_PER_SEC=1
DISCORD_RATE_PER_SEC=45
OUTBOX_BATCH_SIZE=200
OUTBOX_CONCURRENCY=32
OUTBOX_LEASE_MS=60000
OUTBOX_MAX_ATTEMPTS=20
OUTBOX_POLL_MS=100
OUTBOX_DEDUP_TTL_SEC=604800
NOTIFICATION_MAX_DB_LATENCY_MS=500
NOTIFICATION_MAX_RETRY_BACKLOG=100000
ENABLE_TELEGRAM_NOTIFICATIONS=false
TELEGRAM_BOT_TOKEN=

ENABLE_DISCORD_NOTIFICATIONS=false
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_SKIP_COMMAND_REGISTRATION=false
BOT_GATEWAY_ENABLED=false

# Worker scaling and stream retention
REDIS_STREAM_STALE_MS=60000
MARKET_EVENT_MAX_ATTEMPTS=10
MARKET_WORKER_CONCURRENCY=32
MARKET_METRIC_BOOTSTRAP_BATCH=1000
MARKET_METRIC_BOOTSTRAP_LEASE_MS=60000
MARKET_METRIC_RETENTION_DAYS=14
REDIS_STREAM_MAXLEN_MARKET_EVENTS=1000000
REDIS_STREAM_MAXLEN_TICKS=500000
REDIS_STREAM_MAXLEN_NOTIFICATIONS=2000000
REDIS_STREAM_MAXLEN_DEAD_LETTERS=500000
MATCHER_SHARD_ID=0
MATCHER_SHARD_COUNT=1
RUST_MATCHER_RESYNC_SECS=300
RUST_MATCHER_VERSION=rust-alert-matcher-1.0.0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3010/api
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_DISCORD_CLIENT_ID=
